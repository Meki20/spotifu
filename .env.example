# SpotiFU environment variables
# Copy to .env and fill in values before running.
# Secrets (jwt_secret, soulseek_username/password, lastfm/fanarttv API keys)
# can alternatively be stored in .secrets (JSON) instead of environment variables.

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Default: postgresql://spotifu:spotifu@localhost:5432/spotifu
DATABASE_URL=postgresql://spotifu:spotifu@localhost:5432/spotifu

# ── Auth ──────────────────────────────────────────────────────────────────────

# JWT signing secret. Minimum 32 characters. Required.
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# Path to the .secrets JSON file (contains jwt_secret, soulseek credentials,
# and API keys as an alternative to env vars).
# Default: <repo-root>/.secrets
# SECRETS_FILE=/path/to/.secrets

# ── Storage ───────────────────────────────────────────────────────────────────

# Directory for downloaded audio files, cover art cache, and artist images.
# Default: <hardcoded dev path> — always set this in production.
CACHE_DIR=/data/spotifu/cache

# ── Server ────────────────────────────────────────────────────────────────────

# Base URL the server uses to build self-referential URLs (e.g. local cover art).
# Default: http://localhost:1985
API_BASE_URL=http://localhost:1985

# Comma-separated CORS origins for production. Default: * (dev/LAN).
# ALLOWED_ORIGINS=http://localhost:1984,http://192.168.1.100:1984

# Allow new user registration. Set false after creating the first admin.
# ALLOW_REGISTRATION=true

# ── mDNS (LAN discovery) ──────────────────────────────────────────────────────

# Register _spotifu._tcp on the LAN. Default: true on bare metal, false in Docker.
# MDNS_ENABLED=true

# Hostname advertised as spotifu.local (without .local suffix).
# MDNS_HOSTNAME=spotifu

# Port advertised via mDNS. Default: 1985
# MDNS_PORT=1985

# ── Soulseek ──────────────────────────────────────────────────────────────────

# Soulseek account credentials. Can also be stored in .secrets.
SOULSEEK_USERNAME=your_soulseek_username
SOULSEEK_PASSWORD=your_soulseek_password

# Minimum peer avg_speed (bytes/s) to be considered for download ranking.
# Default: 500000 (~500 KB/s)
# SOULSEEK_MIN_AVG_SPEED=500000

# ── External API keys ─────────────────────────────────────────────────────────

# Last.fm API key — used for similar-artist/track data.
# Can also be stored in .secrets as "lastfm_api_key".
# LASTFM_API_KEY=

# fanart.tv API key — used for high-quality artist images.
# Stored in .secrets as "fanarttv_api_key" (configurable via Settings UI).
# FANARTTV_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────

# Root log level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Default: INFO
# LOG_LEVEL=INFO

# Per-module log level overrides (same values as LOG_LEVEL).
# LOG_LEVEL_SOULSEEK=DEBUG
# LOG_LEVEL_DOWNLOAD=DEBUG
# LOG_LEVEL_MUSICBRAINZ=DEBUG
# LOG_LEVEL_PROVIDERS=DEBUG

# ── Client (Vite) ─────────────────────────────────────────────────────────────
# Place these in client/.env (or client/.env.local).

# Backend API base URL. Default: http://localhost:1985
# VITE_API_URL=http://localhost:1985

# WebSocket URL override. Defaults to VITE_API_URL with ws:// scheme.
# VITE_WS_URL=ws://localhost:1985
