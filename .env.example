# SpotiFU — optional host-side environment overrides.
#
# Copy to `.env` and uncomment/edit any line you want to override.
#
# All secrets (JWT signing key, Soulseek credentials, optional API keys)
# live in `./.secrets` and are managed by the first-run wizard:
#   bash scripts/install.sh wizard
#
# Do NOT put credentials in this file unless you have a specific reason to
# override what the wizard wrote.

# ── Server ────────────────────────────────────────────────────────────────────

# Public URL the server uses to build self-referential URLs (e.g. local cover art).
# Set to the LAN IP of this host when serving remote clients (e.g. http://192.168.1.100:1985).
# Default: http://localhost:1985
# API_BASE_URL=http://localhost:1985

# Comma-separated CORS origins. Default: * (open; recommended for LAN).
# For production: ALLOWED_ORIGINS=https://your.domain
# ALLOWED_ORIGINS=*

# Allow new user registration. Set false after creating the first admin.
# ALLOW_REGISTRATION=true

# ── mDNS (LAN discovery) ──────────────────────────────────────────────────────

# Register _spotifu._tcp on the LAN. Auto-disabled in Docker.
# MDNS_ENABLED=true

# Hostname advertised as spotifu.local (without .local suffix).
# MDNS_HOSTNAME=spotifu

# Port advertised via mDNS.
# MDNS_PORT=1985

# ── Soulseek ──────────────────────────────────────────────────────────────────

# Override the Soulseek credentials written by the wizard. Normally leave blank.
# SOULSEEK_USERNAME=
# SOULSEEK_PASSWORD=

# Minimum peer avg_speed (bytes/s) for download ranking.
# Default: 500000 (~500 KB/s)
# SOULSEEK_MIN_AVG_SPEED=500000

# ── External API keys ─────────────────────────────────────────────────────────

# Override the keys written by the wizard.
# LASTFM_API_KEY=
# FANARTTV_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────

# Root log level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# LOG_LEVEL=INFO

# Per-module log level overrides.
# LOG_LEVEL_SOULSEEK=DEBUG
# LOG_LEVEL_DOWNLOAD=DEBUG
# LOG_LEVEL_MUSICBRAINZ=DEBUG
# LOG_LEVEL_PROVIDERS=DEBUG

# ── Client (Vite, for browser dev only) ───────────────────────────────────────
# Place these in client/.env (or client/.env.local).

# Backend API base URL. Default: http://localhost:1985
# VITE_API_URL=http://localhost:1985

# WebSocket URL override. Defaults to VITE_API_URL with ws:// scheme.
# VITE_WS_URL=ws://localhost:1985
