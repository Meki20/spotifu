{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SpotiFU",
  "version": "0.1.0",
  "identifier": "com.spotifu.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1984",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SpotiFU",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://*:* https://*:* ws://*:* wss://*:* ipc:; img-src 'self' data: https: http://*:*; media-src 'self' http://*:* https://*:* blob:; object-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
