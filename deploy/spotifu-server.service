[Unit]
Description=SpotiFU API server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=spotifu
Group=spotifu
WorkingDirectory=/opt/spotifu/server
EnvironmentFile=/etc/spotifu/env
ExecStart=/opt/spotifu/server/venv/bin/uvicorn main:app --host 0.0.0.0 --port 1985
Restart=on-failure
RestartSec=5

# Recommended env in /etc/spotifu/env:
# DATABASE_URL=postgresql://spotifu:...@localhost:5432/spotifu
# CACHE_DIR=/var/lib/spotifu/cache
# API_BASE_URL=http://192.168.1.100:1985
# MDNS_ENABLED=true
# JWT_SECRET=...

[Install]
WantedBy=multi-user.target
